<%= form_with model: [:admin, category], class: "admin-form" do |f| %>
  <% if category.errors.any? %>
    <div class="admin-form-error">
      <%= pluralize(category.errors.count, "error") %> stopped this from saving:
      <%= category.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>

  <div class="admin-actions" style="justify-content: flex-start;">
    <%= f.submit "Save category", class: "admin-btn" %>
    <%= link_to "Cancel", admin_categories_path, class: "admin-btn admin-btn-ghost" %>
  </div>
<% end %>