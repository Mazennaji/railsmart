<%= form_with model: [:admin, product], class: "admin-form" do |f| %>
  <% if product.errors.any? %>
    <div class="admin-form-error">
      <%= pluralize(product.errors.count, "error") %> stopped this from saving:
      <%= product.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div class="field">
    <%= f.label :category_id, "Category" %>
    <%= f.collection_select :category_id, Category.order(:name), :id, :name, prompt: "Choose a category" %>
  </div>
  <div class="field">
    <%= f.label :description %>
    <%= f.text_area :description %>
  </div>
  <div class="field">
    <%= f.label :price %>
    <%= f.number_field :price, step: 0.01 %>
  </div>
  <div class="field">
    <%= f.label :stock %>
    <%= f.number_field :stock %>
  </div>

  <div class="admin-actions" style="justify-content: flex-start;">
    <%= f.submit "Save product", class: "admin-btn" %>
    <%= link_to "Cancel", admin_products_path, class: "admin-btn admin-btn-ghost" %>
  </div>
<% end %>