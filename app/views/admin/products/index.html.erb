<div class="admin-page-head">
  <h1>Products</h1>
  <%= link_to "New product", new_admin_product_path, class: "admin-btn" %>
</div>

<div class="admin-panel">
  <table class="admin-table">
    <thead>
      <tr><th>Name</th><th>Category</th><th class="num">Price</th><th class="num">Stock</th><th></th></tr>
    </thead>
    <tbody>
      <% @products.each do |product| %>
        <tr>
          <td><%= product.name %></td>
          <td><%= product.category.name %></td>
          <td class="num">$<%= number_with_precision(product.price, precision: 2) %></td>
          <td class="num <%= "stock-low" if product.stock <= 5 %>"><%= product.stock %></td>
          <td>
            <div class="admin-actions">
              <%= link_to "Edit", edit_admin_product_path(product), class: "admin-btn admin-btn-ghost admin-btn-sm" %>
              <%= button_to "Delete", admin_product_path(product), method: :delete, class: "admin-btn admin-btn-ghost admin-btn-sm admin-btn-danger", form: { data: { turbo_confirm: "Delete #{product.name}?" } } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <div class="admin-pagination"><%== pagy_nav(@pagy) %></div>
</div>