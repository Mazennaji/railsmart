<!DOCTYPE html>
<html>
  <head>
    <title>railsmart — Forged Goods</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href="<%= root_path %>" class="brand">
          railsmart <span class="brand-tag">forged goods</span>
        </a>
        <nav class="site-nav">
          <% Category.order(:name).each do |category| %>
            <%= link_to category.name, category_path(category) %>
          <% end %>
          <%= link_to cart_path, class: "cart-link" do %>
            Cart (<%= @cart_count || 0 %>)
          <% end %>
            <% if logged_in? %>
            <%= link_to "Orders", orders_path %>
            <% if current_user.admin? %>
              <%= link_to "Admin", admin_root_path %>
            <% end %>
            <%= button_to "Log out", logout_path, method: :delete, class: "btn-ghost", style: "background:none;border:none;color:var(--stone);cursor:pointer;padding:0;font-size:14px;" %>
          <% else %>
            <%= link_to "Log in", login_path %>
            <%= link_to "Sign up", signup_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice.present? %>
      <div class="flash flash-notice wrap"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash flash-alert wrap"><%= alert %></div>
    <% end %>

    <main class="wrap">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>railsmart</span> — a Ruby on Rails portfolio project.
      </div>
    </footer>
  </body>
</html>