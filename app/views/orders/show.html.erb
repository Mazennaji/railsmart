<div class="section-head" style="margin-top: 40px;">
  <div>
    <h2>Order confirmed</h2>
    <p class="hero-sub" style="margin-top: 8px;">
      Thank you, <%= @order.customer_name %>. A receipt is on its way to <%= @order.email %>.
    </p>
  </div>
  <span class="meta">Order #<%= @order.id %> &middot; <%= @order.status.capitalize %></span>
</div>

<table class="table">
  <thead>
    <tr>
      <th>Product</th>
      <th class="num">Price</th>
      <th class="num">Quantity</th>
      <th class="num">Subtotal</th>
    </tr>
  </thead>
  <tbody>
    <% @order.order_items.includes(:product).each do |item| %>
      <tr>
        <td><%= item.product.name %></td>
        <td class="num">$<%= number_with_precision(item.price, precision: 2) %></td>
        <td class="num"><%= item.quantity %></td>
        <td class="num">$<%= number_with_precision(item.subtotal, precision: 2) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="cart-total">Total: $<%= number_with_precision(@order.total, precision: 2) %></div>

<div style="text-align: right;">
  <%= link_to "Back to the catalog", root_path, class: "btn" %>
</div>